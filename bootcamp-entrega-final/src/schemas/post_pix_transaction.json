{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "transaction_date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "type": {
      "type": "string",
      "enum": [
        "payment",
        "refund"
      ]
    },
    "second_factor_passed": {
      "type": "boolean"
    },
    "friction_answer": {
      "type": "string",
      "enum": [
        "YES",
        "NO",
        "SKIP"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "internet",
            "celular",
            "computador",
            "tablet",
            "relogio",
            "app"
          ]
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "geolocation": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "accuracy_m": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        },
        "remote_access_detected": {
          "type": "boolean"
        },
        "call_in_progress": {
          "type": "boolean"
        },
        "interaction": {
          "type": "object",
          "properties": {
            "is_robotic_movement": {
              "type": "boolean"
            },
            "typing_cadence_std_ms": {
              "type": "number",
              "minimum": 0
            },
            "session_idle_then_burst": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "source_account": {
      "type": "object",
      "properties": {
        "account_key": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "document_number": {
          "type": "string",
          "pattern": "^[0-9./-]{11,18}$"
        },
        "participant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "has_trusted_contact": {
          "type": "boolean"
        },
        "owner": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 255
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "document_number"
      ],
      "additionalProperties": false
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "account_key": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "document_number": {
          "type": "string",
          "pattern": "^[0-9./-]{11,18}$"
        },
        "participant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "owner": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 255
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "document_number"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "amount",
    "transaction_date",
    "source_account",
    "destination_account"
  ],
  "additionalProperties": false
}
